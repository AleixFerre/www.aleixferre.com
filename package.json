    "eslint-plugin-astro": "^3.2.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sass": "^1.106.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3",
