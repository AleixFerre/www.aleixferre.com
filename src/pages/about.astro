---
import TabLayout from '../layouts/TabLayout.astro';
import Card from '../components/ui/Card.astro';
import InfoCard from '../components/ui/InfoCard.astro';
import { ABOUT } from '../data/about';
import { backgroundImage } from '../lib/assets';
import { ageOn } from '../lib/dates';

const age = ageOn(new Date(ABOUT.profile.birthDate));

const profileBackground = await backgroundImage(ABOUT.profile.background, 'profile');
---

<TabLayout
  title="About"
  description="Aleix Ferré, Game Designer & Developer: web dashboards and mobile apps at ClearPeaks, Yuuko Games by night. Education, professional experience and languages."
>
  <div class="grid">
    <Card class="box hero">
      <p class="eyebrow">{ABOUT.hero.eyebrow}</p>
      <h2>{ABOUT.hero.title}</h2>
      <div class="pill-row">
        {ABOUT.hero.pills.map((pill) => (
          <span class="pill">{pill}</span>
        ))}
      </div>
      <p class="muted" set:html={ABOUT.hero.description} />
    </Card>
    <Card class="box profile" style={`--profile-background: ${profileBackground}`}>
      <p class="name">{ABOUT.profile.name}</p>
      <p class="age">{age} years old</p>
      <p class="age">{ABOUT.profile.location}</p>
    </Card>
    <Card class="box focus">
      <p>{ABOUT.focus.title}</p>
      <ul class="bullets">
        {ABOUT.focus.items.map((item) => (
          <li set:html={item} />
        ))}
      </ul>
    </Card>
    <Card class="box education">
      <p>{ABOUT.education.title}</p>
      <div class="list">
        {ABOUT.education.items.map((education) => (
          <InfoCard class="item" {...education} imageOpacity={0.5} />
        ))}
      </div>
    </Card>
    <Card class="box professional">
      <p>{ABOUT.professionalExperience.title}</p>
      <div class="list">
        {ABOUT.professionalExperience.items.map((experience) => (
          <InfoCard class="item" {...experience} />
        ))}
      </div>
    </Card>
    <Card class="box languages">
      <p>{ABOUT.languages.title}</p>
      <div class="list">
        {ABOUT.languages.items.map((language) => (
          <InfoCard class="item" {...language} imageMode="flag" align="left" />
        ))}
      </div>
    </Card>
  </div>
</TabLayout>

<style lang="scss">
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    grid-template-areas:
      'hero hero profile'
      'focus professional languages'
      'education professional languages';
    gap: 16px;
    width: 100%;
    height: 100%;
    @include stack-on-mobile;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    opacity: 0.8;
    margin: 0;
  }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 10px 0 16px 0;
  }

  .pill {
    background: rgba(255, 255, 255, 0.09);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-pill);
    padding: 6px 12px;
    font-size: 0.85rem;
    letter-spacing: 0.01em;
  }

  .muted {
    opacity: 0.9;
    line-height: 1.5;
    text-wrap: balance;
  }

  .focus {
    display: flex;
    flex-direction: column;
    gap: 8px;

    .bullets {
      padding-left: 1.1em;
      margin: 0;
      display: grid;
      gap: 6px;
      line-height: 1.4;
      text-wrap: balance;
      overflow: auto;
      height: 100%;
    }
  }

  .box {
    padding: 16px;

    &.hero {
      grid-area: hero;
    }

    &.profile {
      grid-area: profile;
      background-image: var(--profile-background), linear-gradient(180deg, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.7));
      background-size: cover, cover;
      background-position: center, center;
      background-repeat: no-repeat, no-repeat;
      position: relative;
      box-shadow: var(--shadow-inset);

      @include mobile {
        height: 25em;
      }
      .name {
        text-align: end;
        text-wrap-mode: nowrap;
        font-size: 1.5em;
        font-weight: bold;
        margin: 0;
        position: relative;
        z-index: 1;
      }

      .age {
        text-align: end;
        margin: 0;
        position: relative;
        z-index: 1;
      }
    }
    &.education {
      grid-area: education;
    }

    &.professional {
      grid-area: professional;
    }

    &.focus {
      grid-area: focus;
    }

    &.languages {
      grid-area: languages;
    }
    p {
      margin: 8px 0 8px 0;
      font-size: 0.85rem;
    }

    &.hero {
      padding: 2rem;
      background:
        radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.01)),
        linear-gradient(160deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));

      h2 {
        margin: 4px 0 12px 0;
        font-size: clamp(1.4rem, 2vw, 1rem);
        line-height: 1.2;
      }
    }

    .list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      height: calc(100% - 1lh - 16px);
      justify-content: space-evenly;
    }
  }

  .item {
    flex: 1;
  }
</style>
