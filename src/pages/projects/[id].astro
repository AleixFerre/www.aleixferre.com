---
import TabLayout from '../../layouts/TabLayout.astro';
import ProjectSidebar from '../../components/project/ProjectSidebar.astro';
import ProjectDetails from '../../components/project/ProjectDetails.astro';
import { ALL_PROJECTS, type Project } from '../../data/projects';
import { asset } from '../../utils/assets';

export function getStaticPaths() {
  return ALL_PROJECTS.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<TabLayout
  title={`${project.name} | Aleix Ferré`}
  description={project.description}
  image={asset(project.image).src}
>
  <div class="project-row appear">
    <ProjectSidebar currentId={project.id} />
    <ProjectDetails project={project} />
  </div>
</TabLayout>

<style lang="scss">
  .project-row {
    display: flex;
    flex-direction: row;
    gap: 10px;
    width: 100%;
    align-items: center;
  }
</style>
