---
import TabLayout from '../../layouts/TabLayout.astro';
import Gallery from '../../components/Gallery.astro';
import Img from '../../components/Img.astro';
import { TABS } from '../../data/tabs';
import { ALL_PROJECTS, type Project } from '../../data/projects';
import { formatMonth } from '../../utils/format-month';
import { formatDuration } from '../../utils/format-duration';
import { asset, backgroundImage } from '../../utils/assets';

export function getStaticPaths() {
  return ALL_PROJECTS.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

const backgrounds = await Promise.all(ALL_PROJECTS.map((item) => backgroundImage(item.backgroundImage, 'sidebarCard')));
---

<TabLayout
  activeTab={TABS.PROJECTS}
  title={`${project.name} | Aleix Ferré`}
  description={project.description}
  image={asset(project.image).src}
>
  <div class="project-row appear">
    <div class="grid list not-mobile-only">
      <a class="button stick" href="/projects">
        <img class="back" src="/assets/back.svg" alt="" />
        <span class="see-all">See All</span>
      </a>
      {
        ALL_PROJECTS.map((item, index) => (
          <a
            class:list={['box', 'project', { selected: item.id === project.id }]}
            style={`background-image: ${backgrounds[index]};`}
            href={`/projects/${item.id}`}
          >
            <Img src={item.image} class="inner" alt={item.name} variant="card" />
          </a>
        ))
      }
    </div>

    <div class="details">
      <div class="sticky-actions row">
        <a class="button mobile-only" href="/projects">
          <img class="back" src="/assets/back.svg" alt="See All" />
        </a>
        <div class="heading row appear-lite" data-swap-region="heading">
          <h2 class="title">{project.name}</h2>
          {
            project.additionalUrl && (
              <>
                <a class="button not-mobile-only" href={project.additionalUrl[0]} target="_blank">
                  {project.additionalUrl[1]}
                </a>
                <a class="button mobile-only" href={project.additionalUrl[0]} target="_blank">
                  <img src="/assets/projects/_actions/project_report.svg" alt="Project Report" />
                </a>
              </>
            )
          }
        </div>
        <a class="button not-mobile-only" href={project.url} target="_blank" data-sync-attributes="visit">
          Visit Project
        </a>
        <a class="button mobile-only" href={project.url} target="_blank" data-sync-attributes="visit-icon">
          <img src="/assets/projects/_actions/visit_project.svg" alt="Visit Project" />
        </a>
      </div>
      <div class="appear-lite" data-swap-region="body">
        <div class="separator"></div>
        <p>{project.description}</p>
        {project.images.length > 0 && <Gallery images={project.images} />}
        <h3>Details</h3>
        <ul>
          {
            Object.entries(project.details).map(([key, value]) => (
              <li>
                <b>{key}:</b><span> {value}</span>
              </li>
            ))
          }
        </ul>
        {
          project.goodForYouIf && (
            <div>
              <h3>Good for you if</h3>
              <ul>
                {project.goodForYouIf.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        }
        {
          project.whatILearned && (
            <div>
              <h3>What I learned</h3>
              <ul>
                {project.whatILearned.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        }
        <h3>Project Timeline</h3>
        <p>
          {formatMonth(project.createdAt)} - {project.finishedAt ? <span>{formatMonth(project.finishedAt)} ({formatDuration(project.createdAt, project.finishedAt)})</span> : <span>In Progress</span>}
        </p>
      </div>
    </div>
  </div>
</TabLayout>

<script>
  document.addEventListener('astro:after-swap', () => {
    const current = location.pathname.replace(/\/+$/, '');
    for (const item of document.querySelectorAll<HTMLAnchorElement>('.list a.project')) {
      item.classList.toggle('selected', new URL(item.href).pathname.replace(/\/+$/, '') === current);
    }
    document.querySelector('.details')?.scrollTo({ top: 0 });
  });

  document.addEventListener('astro:page-load', () => {
    document.querySelector('.list .selected')?.scrollIntoView({ block: 'nearest' });
  });
</script>

<style lang="scss">
  .project-row {
    display: flex;
    flex-direction: row;
    gap: 10px;
    width: 100%;
    align-items: center;
  }

  .mobile-only {
    display: none !important;
  }

  @include mobile {
    .mobile-only {
      display: flex !important;
    }

    .not-mobile-only {
      display: none !important;
    }
  }

  .details {
    flex: 1;
    background-color: rgba(240, 248, 255, 0.103);
    padding: 2em;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    height: 70vh;
    overflow: auto;
    position: relative;
    scroll-padding-top: 12px;
    font-size: 1rem;
    line-height: 1.6;

    @include mobile {
      height: auto;
      padding: 1.25em;
      overflow: visible;
      font-size: 1.05rem;
    }

    .separator {
      height: 1rem;
    }

    .sticky-actions {
      position: sticky;
      top: 10px;
      z-index: 8;
      background: rgba(16, 18, 26, 0.6);
      backdrop-filter: blur(6px);
      padding: 0.75em 0.75em 0.75em 1.4em;
      border-radius: var(--radius-sm);
      border: 1px solid rgba(255, 255, 255, 0.04);
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);

      @include mobile {
        font-size: 0.8rem;
        top: 8px;
        margin: 0 -0.5em 0.75em -0.5em;
        padding: 0.85em 1em;
        z-index: 12;
      }
    }

    .row {
      display: flex;
      flex-direction: row;
      gap: 10px;
      align-items: center;

      .heading {
        flex: 1;
      }

      .title {
        flex: 1;
        margin: 0;
      }

      .button {
        background-color: rgba(0, 0, 0, 0.226);
        border-radius: var(--radius-sm);
        padding: 10px;
        display: flex;
        padding: 1em;
        align-items: center;
        justify-content: center;
        gap: 10px;
        cursor: pointer;
        transition:
          background-color var(--duration-base) ease,
          font-weight var(--duration-base) ease;
        color: white;
        text-decoration: none;
        font-family: var(--font-mono);
        text-align: center;
      }
    }
  }

  .see-all {
    text-wrap-mode: nowrap;
  }

  .back {
    width: 20px;
    height: 20px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 10px;
    width: 100%;
    height: 100%;

    &.list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-width: 12vw;
      min-width: 180px;
      flex: 0 0 12vw;
      height: 90vh;
      overflow-y: auto;
      overflow-x: hidden;
      border-radius: var(--radius-sm);
      position: relative;

      .button.stick {
        position: sticky;
        top: 0;
        align-self: stretch;
        z-index: 7;
        background: rgba(16, 18, 26, 0.75);
        border-radius: var(--radius-sm);
        border: 1px solid rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(6px);
        display: flex;
        align-items: center;
        justify-content: center;
      }
    }

    @include stack-on-mobile;

    .box {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
  }

  .box {
    background-color: var(--surface-flat);
    border-radius: var(--radius-sm);
    padding: 10px;
  }

  .project {
    filter: brightness(0.8);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
    transition:
      filter var(--duration-base) ease,
      transform var(--duration-base) ease,
      margin var(--duration-base) ease;
    cursor: pointer;
    flex: 1;
    min-height: 50px;

    &:hover {
      filter: brightness(1);
    }

    @include motion-safe {
      &:hover {
        transform: translateY(-4px) scale(1.01);

        img {
          transform: scale(1.05);
        }
      }
    }

    &.selected {
      margin: 0 2px;
      transform: scale(1.03);

      img {
        transform: scale(1.1);
      }
    }

    @include motion-safe {
      &.selected:hover {
        transform: translateY(-4px) scale(1.03);
        img {
          transform: scale(1.1);
        }
      }
    }

    &:not(.selected) {
      filter: brightness(0.3);
      box-shadow: 0 0 0 0 transparent;
    }

    img {
      width: auto;
      height: 70%;
      max-width: 70%;
      object-fit: contain;
      aspect-ratio: inherit;
      transition: transform var(--duration-base) ease;
      pointer-events: none;
    }
  }

  .button {
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
    border-radius: var(--radius-sm);
    padding: 12px;
    height: 1lh;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    cursor: pointer;
    transition:
      background-color var(--duration-base) ease,
      font-weight var(--duration-base) ease;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    font-weight: 600;
    letter-spacing: 0.02em;

    &:hover {
      background-color: rgba(0, 0, 0, 0.35);
      font-weight: bold;
    }

    img {
      width: 20px;
      height: 20px;
      cursor: pointer;
    }
  }
</style>
