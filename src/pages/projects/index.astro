---
import TabLayout from '../../layouts/TabLayout.astro';
import ProjectCard from '../../components/project/ProjectCard.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<TabLayout
  title="Projects"
  description="Games and tools by Aleix Ferré, from Yuuko Games and Masters Arena to the USignals Unity package, with screenshots, details and lessons learned."
>
  <div class="grid appear">
    {
      projects.map((item, index) => (
        <ProjectCard class:list={['item', { wide: item.data.highlight }]} project={item} priority={index < 2} />
      ))
    }
  </div>
</TabLayout>

<style lang="scss">
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(4, 1fr);
    gap: 10px;
    width: 100%;
    height: 100%;

    @include stack-on-mobile {
      width: 100%;
      height: 100rem;
    }
  }

  .item {
    flex: 1;
  }

  .wide {
    grid-column: span 2;
  }
</style>
