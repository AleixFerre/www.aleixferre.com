---
import TabLayout from '../layouts/TabLayout.astro';
import Card from '../components/ui/Card.astro';
import Stat from '../components/ui/Stat.astro';
import IconText from '../components/ui/IconText.astro';
import Img from '../components/ui/Img.astro';
import ProjectCard from '../components/project/ProjectCard.astro';
import { ABOUT } from '../data/about';
import { HOME } from '../data/home';
import { getProject } from '../lib/projects';
import { yearsSince } from '../utils/years-since';
import { backgroundImage } from '../lib/assets';

const profileBackground = await backgroundImage(ABOUT.profile.background, 'profile');

const featured = await Promise.all(
  HOME.featured.map(async ({ id, size }) => ({ project: await getProject(id), size })),
);
---

<TabLayout>
  <div class="grid">
    <Card class="box profile" href="/about" style={`--profile-background: ${profileBackground}`}>
      <Img src={ABOUT.profile.photo} class="profile-image" alt={ABOUT.profile.name} variant="profile" priority />
      <p class="name">Game Designer <br />& Developer</p>
    </Card>
    <Card class="box">
      <p>Experience</p>
      <div class="grid experience">
        {
          HOME.experience.map(({ label, since }) => (
            <Stat label={label} value={yearsSince(since)} suffix="+" caption="years" />
          ))
        }
      </div>
    </Card>
    <Card class="box">
      <p>Specialized In</p>
      <div class="grid specialized">
        {HOME.specializations.map(({ text, icon }) => <IconText variant="tile" text={text} icon={icon} />)}
      </div>
    </Card>
    <Card class="box featured">
      <p>Featured Projects</p>
      <div class="grid projects">
        {
          featured.map(({ project, size }) => (
            <ProjectCard class:list={['item', size]} project={project} variant="featured" />
          ))
        }
      </div>
    </Card>
  </div>
</TabLayout>

<style lang="scss">
  $margin-p: 8px;

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 10px;
    width: 100%;
    height: 100%;

    @include stack-on-mobile;

    &.projects {
      grid-template-columns: repeat(6, 1fr);
      grid-template-rows: repeat(3, 1fr);
      height: calc(100% - 1lh - ($margin-p * 2));

      @include mobile {
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        grid-template-rows: auto;
        height: auto;
      }
    }

    &.experience {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(1, 1fr);
      height: calc(100% - 1lh - ($margin-p * 2));

      @include mobile {
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        grid-template-rows: auto;
        height: auto;
        width: 100%;
      }
    }

    &.specialized {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(1, 1fr);
      height: calc(100% - 1lh - ($margin-p * 2));
      gap: 12px;

      @include mobile {
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        grid-template-rows: auto;
        height: auto;
        width: 100%;
      }
    }
  }

  .item {
    grid-column: span 2;

    &.large {
      grid-column: span 3;
      grid-row: span 2;
    }

    @include mobile {
      height: 120px;
    }
  }

  .box {
    &.featured {
      grid-column: span 3;
      grid-row: span 2;
      background-size: cover;
      background-position: center;
    }

    p {
      margin: $margin-p 0 $margin-p 0;
    }

    &.profile {
      background-image: var(--profile-background),
        linear-gradient(180deg, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.7));
      background-size: cover, cover;
      background-position: center, center;
      background-repeat: no-repeat, no-repeat;
      transition:
        filter var(--duration-base) ease,
        transform var(--duration-base) ease;
      cursor: pointer;
      position: relative;
      box-shadow: var(--shadow-inset);

      @include mobile {
        height: 50vw;
      }

      .profile-image {
        position: absolute;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      &:hover {
        filter: brightness(1.05);
      }

      @include motion-safe {
        &:hover {
          transform: translateY(-4px);
        }
      }
    }

    .name {
      display: flex;
      text-align: end;
      text-wrap-mode: nowrap;
      justify-content: end;
      font-size: 1.5em;
      font-weight: bold;
      margin: 0;
    }
  }
</style>
