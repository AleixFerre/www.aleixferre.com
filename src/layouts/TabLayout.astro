---
import BaseLayout from './BaseLayout.astro';
import BackgroundStars from '../components/BackgroundStars.astro';
import { TABS, TABS_LIST } from '../data/tabs';
import { ariaCurrentValue, isCurrent, type CurrentMode } from '../lib/navigation';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const tabs = (Object.entries(TABS_LIST) as [TABS, string][]).map(([tab, label]) => {
  const href = tab === TABS.HOME ? '/' : `/${tab}`;
  const mode: CurrentMode = tab === TABS.HOME ? 'page' : 'section';
  return { tab, label, href, mode, current: isCurrent(Astro.url.pathname, href, mode) };
});
---

<BaseLayout {...Astro.props}>
  <main class="row tabs">
    <BackgroundStars />
    {
      tabs.map(({ tab, label, href, mode, current }) => (
        <>
          <a
            class="col tab-link"
            href={href}
            data-tab-link={tab}
            data-current={mode}
            aria-current={current ? ariaCurrentValue(mode) : undefined}
          >
            <p>{label}</p>
          </a>
          <div class="col panel scrollable content-hide" data-tab-panel={tab}>
            {current && (
              <div class="main-content">
                <slot />
              </div>
            )}
          </div>
        </>
      ))
    }
  </main>
</BaseLayout>

<style lang="scss">
  .row {
    display: flex;
    flex-direction: row;
    color: white;
    background: radial-gradient(circle at top left, #4d416a77, #10101477);
    height: 100dvh;
    width: 100dvw;

    @include mobile {
      flex-direction: column;
    }
  }

  .col {
    flex: 0;
    font-size: 1em;
    transition:
      flex-grow var(--duration-base) ease-in-out,
      opacity var(--duration-base) ease-in-out;
  }

  .tab-link {
    background-color: rgba(255, 255, 255, 0.1);
    outline: 1px solid rgba(0, 0, 0, 0.5);
    writing-mode: sideways-lr;
    text-orientation: mixed;
    font-size: 1.5em;
    display: flex;
    font-weight: normal;
    padding-bottom: 1em;
    cursor: pointer;

    @include mobile {
      font-size: 1.2em;
      writing-mode: horizontal-tb;
      text-orientation: upright;
      padding-left: 1em;
      padding-bottom: 0;
    }

    &[aria-current] {
      font-weight: bold;
    }

    &:hover {
      $shadow-color: #ffffff34;

      text-shadow: -1px -1px 0 $shadow-color, 1px -1px 0 $shadow-color,
        -1px 1px 0 $shadow-color, 1px 1px 0 $shadow-color;
      transition: text-shadow 0.5s;
    }
  }

  .content-hide {
    width: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    content-visibility: auto;
    transition:
      flex-grow var(--duration-base) ease-in-out,
      opacity var(--duration-base) ease-in-out,
      visibility 0s var(--duration-base);
  }

  .tab-link[aria-current] + .panel {
    flex: 1;
    width: auto;
    opacity: 1;
    visibility: visible;
    content-visibility: visible;
    transition-delay: 0s;
  }

  .scrollable {
    overflow-y: auto;
  }

  .main-content {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    height: calc(100vh - 40px);

    @include mobile {
      font-size: 1.2em;
      height: auto;
    }
  }
</style>

<script>
  import { swapFunctions } from 'astro:transitions/client';
  import '../scripts/current-links';

  const STYLES = 'link[rel=stylesheet], style';

  const keepLoadedStyles = (newDocument: Document) => {
    const incoming = [...newDocument.head.querySelectorAll(STYLES)];
    for (const style of document.head.querySelectorAll(STYLES)) {
      if (!incoming.some((el) => el.isEqualNode(style))) newDocument.head.append(style.cloneNode(true));
    }
  };

  const isLoaded = (script: HTMLScriptElement) =>
    [...document.scripts].some((loaded) =>
      script.src ? loaded.src === script.src : loaded.textContent === script.textContent,
    );

  const appendNewScripts = (newDocument: Document) => {
    for (const script of newDocument.body.querySelectorAll<HTMLScriptElement>(':scope > script')) {
      if (!isLoaded(script)) document.body.append(script);
    }
  };

  const syncAttributes = (content: Element, newContent: Element) => {
    for (const newElement of newContent.querySelectorAll<HTMLElement>('[data-sync-attributes]')) {
      const element = content.querySelector(`[data-sync-attributes="${newElement.dataset.syncAttributes}"]`);
      for (const { name, value } of newElement.attributes) element?.setAttribute(name, value);
    }
  };

  const swapRegions = (content: Element, newContent: Element) => {
    const newRegions = [...newContent.querySelectorAll<HTMLElement>('[data-swap-region]')];
    const regions = newRegions.map((region) =>
      content.querySelector(`[data-swap-region="${region.dataset.swapRegion}"]`),
    );
    if (newRegions.length === 0 || regions.includes(null)) return false;

    regions.forEach((region, index) => region?.replaceWith(newRegions[index]));
    syncAttributes(content, newContent);
    return true;
  };

  const resetScroll = (panel: HTMLElement) => {
    for (const element of [panel, ...panel.querySelectorAll('[data-reset-scroll]')]) element.scrollTop = 0;
  };

  const swapContent = (panel: HTMLElement, newContent: Element) => {
    const content = panel.querySelector('.main-content');

    if (!content) panel.append(newContent);
    else if (!swapRegions(content, newContent)) content.replaceWith(newContent);
    resetScroll(panel);
  };

  const swapTabs = (newDocument: Document) => {
    const tab = newDocument.querySelector<HTMLElement>('[data-tab-link][aria-current]')?.dataset.tabLink;
    const newContent = newDocument.querySelector(`[data-tab-panel="${tab}"] .main-content`);
    const panel = document.querySelector<HTMLElement>(`[data-tab-panel="${tab}"]`);
    if (!tab || !newContent || !panel) return;

    swapContent(panel, newContent);
  };

  document.addEventListener('astro:before-swap', (event) => {
    if (!document.querySelector('.tabs') || !event.newDocument.querySelector('.tabs')) return;

    event.swap = () => {
      swapFunctions.deselectScripts(event.newDocument);
      swapFunctions.swapRootAttributes(event.newDocument);
      keepLoadedStyles(event.newDocument);
      swapFunctions.swapHeadElements(event.newDocument);
      swapTabs(event.newDocument);
      appendNewScripts(event.newDocument);
    };
  });
</script>
