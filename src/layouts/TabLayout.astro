---
import BaseLayout from './BaseLayout.astro';
import BackgroundStars from '../components/BackgroundStars.astro';
import { TABS, TABS_LIST } from '../data/tabs';
import { ariaCurrentValue, isCurrent, type CurrentMode } from '../lib/navigation';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const tabs = (Object.entries(TABS_LIST) as [TABS, string][]).map(([tab, label]) => {
  const href = tab === TABS.HOME ? '/' : `/${tab}`;
  const mode: CurrentMode = tab === TABS.HOME ? 'page' : 'section';
  return { tab, label, href, mode, current: isCurrent(Astro.url.pathname, href, mode) };
});
---

<BaseLayout {...Astro.props}>
  <main class="row">
    <BackgroundStars />
    {
      tabs.map(({ tab, label, href, mode, current }) => (
        <>
          <a
            class="col tab-link"
            href={href}
            data-tab-link={tab}
            data-current={mode}
            aria-current={current ? ariaCurrentValue(mode) : undefined}
          >
            <p>{label}</p>
          </a>
          <div class="col panel scrollable content-hide" data-tab-panel={tab}>
            {current && (
              <div class="main-content" data-tab-content>
                <slot />
              </div>
            )}
          </div>
        </>
      ))
    }
  </main>
</BaseLayout>

<style lang="scss">
  .row {
    display: flex;
    flex-direction: row;
    color: white;
    background: radial-gradient(circle at top left, #4d416a77, #10101477);
    height: 100dvh;
    width: 100dvw;

    @include mobile {
      flex-direction: column;
    }
  }

  .col {
    flex: 0;
    font-size: 1em;
    transition:
      flex-grow var(--duration-base) ease-in-out,
      opacity var(--duration-base) ease-in-out;
  }

  .tab-link {
    background-color: rgba(255, 255, 255, 0.1);
    outline: 1px solid rgba(0, 0, 0, 0.5);
    writing-mode: sideways-lr;
    text-orientation: mixed;
    font-size: 1.5em;
    display: flex;
    font-weight: normal;
    padding-bottom: 1em;
    cursor: pointer;

    @include mobile {
      font-size: 1.2em;
      writing-mode: horizontal-tb;
      text-orientation: upright;
      padding-left: 1em;
      padding-bottom: 0;
    }

    &[aria-current] {
      font-weight: bold;
    }

    &:hover {
      $shadow-color: #ffffff34;

      text-shadow: -1px -1px 0 $shadow-color, 1px -1px 0 $shadow-color,
        -1px 1px 0 $shadow-color, 1px 1px 0 $shadow-color;
      transition: text-shadow 0.5s;
    }
  }

  .content-hide {
    width: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    content-visibility: auto;
    transition:
      flex-grow var(--duration-base) ease-in-out,
      opacity var(--duration-base) ease-in-out,
      visibility 0s var(--duration-base);
  }

  .tab-link[aria-current] + .panel {
    flex: 1;
    width: auto;
    opacity: 1;
    visibility: visible;
    content-visibility: visible;
    transition-delay: 0s;
  }

  .scrollable {
    overflow-y: auto;
  }

  .main-content {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    height: calc(100vh - 40px);

    @include mobile {
      font-size: 1.2em;
      height: auto;
    }
  }
</style>

<script>
  import '../scripts/tab-router';
</script>
