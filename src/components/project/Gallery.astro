---
import type { ImageMetadata } from 'astro';
import 'photoswipe/style.css';
import Img from '../ui/Img.astro';

interface Props {
  images: ImageMetadata[];
  keepOriginal?: boolean;
}

const { images, keepOriginal = false } = Astro.props;

const cols = Math.min(Math.max(images.length, 2), 4);
---

<photo-gallery class="gallery" style={`--cols: ${cols}`}>
  {images.map((image) => (
    <a href={image.src} data-gallery-item data-pswp-width={image.width} data-pswp-height={image.height} target="_blank">
      <Img class="screenshot" src={image} alt="" variant="gallery" keepOriginal={keepOriginal} />
    </a>
  ))}
</photo-gallery>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import type { Bounds, SlideData } from 'photoswipe';

  function fitThumbBounds(thumbBounds: Bounds | undefined, itemData: SlideData): Bounds {
    const thumb = itemData.element?.querySelector('img');
    const width = itemData.width ?? itemData.w;
    const height = itemData.height ?? itemData.h;
    if (!thumb || !width || !height) return thumbBounds!;
    const rect = thumb.getBoundingClientRect();
    const scale = Math.min(rect.width / width, rect.height / height);
    return {
      x: rect.left + (rect.width - width * scale) / 2,
      y: rect.top + (rect.height - height * scale) / 2,
      w: width * scale,
    };
  }

  class PhotoGallery extends HTMLElement {
    private lightbox: PhotoSwipeLightbox | null = null;

    connectedCallback() {
      this.lightbox = new PhotoSwipeLightbox({
        gallery: this,
        children: '[data-gallery-item]',
        loop: true,
        pswpModule: () => import('photoswipe'),
      });
      this.lightbox.addFilter('thumbBounds', fitThumbBounds);
      this.lightbox.init();
    }

    disconnectedCallback() {
      this.lightbox?.destroy();
      this.lightbox = null;
    }
  }

  if (!customElements.get('photo-gallery')) customElements.define('photo-gallery', PhotoGallery);
</script>

<style lang="scss">
  .gallery {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 20px;
    align-items: center;

    .screenshot {
      display: block;
      width: 100%;
      height: auto;
      max-height: 420px;
      border-radius: 12px;
      object-fit: contain;
      transition: transform 0.2s ease-in-out;
      cursor: pointer;

      @include motion-safe {
        &:hover {
          transform: scale(1.02);
        }
      }
    }

    @include mobile {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 82vw;
      grid-template-columns: none;
      gap: 12px;
      overflow-x: auto;
      overflow-y: hidden;
      width: 80vw;
      scroll-snap-type: x mandatory;
      padding: 4px 2px 10px;
      -webkit-overflow-scrolling: touch;

      .screenshot {
        width: 100%;
        max-height: 300px;
        border-radius: 0;
        scroll-snap-align: start;
      }
    }
  }
</style>
