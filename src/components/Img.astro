---
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';
import { asset, keepOriginal, IMAGE_QUALITY, IMAGE_SIZES, IMAGE_WIDTHS, type ImageVariant } from '../utils/assets';

interface Props
  extends Omit<HTMLAttributes<'img'>, 'src' | 'alt' | 'width' | 'height' | 'loading' | 'decoding' | 'sizes'> {
  src: string;
  alt: string;
  variant: ImageVariant;
  priority?: boolean;
}

const { src, alt, variant, priority = false, ...rest } = Astro.props;

const image = asset(src);
const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : undefined;
---

{
  keepOriginal(src) ? (
    <img
      src={image.src}
      alt={alt}
      width={image.width}
      height={image.height}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      {...rest}
    />
  ) : (
    <Image
      src={image}
      alt={alt}
      widths={IMAGE_WIDTHS}
      sizes={IMAGE_SIZES[variant]}
      quality={IMAGE_QUALITY}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      {...rest}
    />
  )
}
