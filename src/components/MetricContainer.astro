---
interface Props {
  title?: string;
  number?: string;
  symbol?: string;
  numberAfterSymbol?: string;
  description: string;
  small?: boolean;
  class?: string;
  style?: string | Record<string, string>;
}

const {
  title = '',
  number = '',
  symbol = '',
  numberAfterSymbol = '',
  description,
  small = false,
  class: className,
  style,
} = Astro.props;
---

<div class:list={['metric-container', className]} style={style}>
  <p class="title">{title}</p>
  <div class="metric">
    <div class:list={['data', { small }]}>
      <span class="number">{number}</span>
      {symbol}
      <span class="number">{numberAfterSymbol}</span>
    </div>
    <div>{description}</div>
  </div>
</div>

<style lang="scss">
  .title {
    font-size: 0.8em;
    text-align: center;
    margin: 0;
    text-wrap: balance;

    @media screen and (max-width: 1000px) {
      font-size: 1.2em;
    }
  }

  .metric {
    font-size: 1em;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;

    @media screen and (max-width: 1000px) {
      font-size: 1.4em;
    }

    .data {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      font-size: 5em;
      text-wrap: balance;

      &.small {
        font-size: 1.5em;
        text-align: center;
        text-wrap: balance;
      }

      .number {
        color: #a078ff;
        font-weight: bold;
      }
    }

    > div:last-child {
      text-wrap: balance;
      text-align: center;
    }
  }

  .metric-container.align-left {
    .title {
      text-align: left;
    }

    .metric {
      align-items: flex-start;

      .data {
        justify-content: flex-start;
        text-align: left;

        &.small {
          text-align: left;
        }
      }

      > div:last-child {
        text-align: left;
      }
    }
  }
</style>
